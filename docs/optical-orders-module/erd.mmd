    optical_orders {
        bigint id PK
        bigint company_id FK
        bigint branch_id FK
        bigint patient_id FK
        bigint patient_prescription_id FK
        bigint sales_customer_id FK
        bigint sales_invoice_id FK
        bigint salesperson_id FK
        bigint lab_supplier_id FK
        bigint frame_product_id FK
        string order_number UK
        string status
        string priority
        date order_date
        date expected_delivery_date
        datetime lab_sent_at
