        bigint id PK
        bigint optical_order_id FK
        bigint sales_payment_id FK
        string payment_number UK
        string payment_method
        decimal amount
        datetime paid_at
    }

    optical_order_documents {
        bigint id PK
        bigint optical_order_id FK
        string document_number UK
        string document_type
